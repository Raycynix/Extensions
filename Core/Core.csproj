<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>


		<PackageId>Extensions.Core</PackageId>
		<Version>1.0.0</Version>
		<Authors>IruNil</Authors>
		<Company>Raycynix</Company>
		<Product>Extensions.Core</Product>
		<Description>Core abstractions, Result model, and common helpers for microservice architecture.</Description>
		<RepositoryUrl>https://github.com/Raycynix/Extensions</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Raycynix/Extensions</PackageProjectUrl>
		<PackageTags>core;extensions;microservices;shared;raycynix</PackageTags>
		<!--<PackageIcon>logo.png</PackageIcon>-->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<ItemGroup>
			<None Include="logo.png" Pack="true" Visible="false" />
		</ItemGroup>

		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors>CS1591</WarningsAsErrors>
	</PropertyGroup>

</Project>
