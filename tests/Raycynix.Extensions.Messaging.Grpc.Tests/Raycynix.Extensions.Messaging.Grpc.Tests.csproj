<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Core" Version="1.53.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="8.9.0"/>
        <PackageReference Include="Microsoft.ApplicationInsights" Version="3.1.0" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.6" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.6" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" Version="2.2.1" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.2.1" />
        <PackageReference Include="Microsoft.Testing.Platform" Version="2.2.1" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.2.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="System.Memory.Data" Version="10.0.6" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Raycynix.Extensions.Messaging\Raycynix.Extensions.Messaging.csproj" />
        <ProjectReference Include="..\..\src\Raycynix.Extensions.Messaging.Abstractions\Raycynix.Extensions.Messaging.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\Raycynix.Extensions.Messaging.Grpc\Raycynix.Extensions.Messaging.Grpc.csproj" />
    </ItemGroup>

</Project>
