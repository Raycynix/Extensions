<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.1.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Added configuration-backed secret resolution so secrets can flow through IConfiguration, including .NET User Secrets, while preserving environment, GitHub-style, and TeamCity-style fallback providers.</PackageReleaseNotes>

        <Description>Unified secret resolution services for Raycynix applications with IConfiguration support and environment-aware fallback providers for local development and CI/CD.</Description>
        <PackageTags>raycynix;secrets;providers;configuration;user-secrets;environment;github;teamcity;secret-management;resolution;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Raycynix.Extensions.Security.Abstractions\Raycynix.Extensions.Security.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.6" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.6" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.6" />
    </ItemGroup>

</Project>
