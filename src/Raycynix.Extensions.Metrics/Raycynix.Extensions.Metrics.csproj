<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.1.3</Version>

        <IsPackable>true</IsPackable>

        <Description>Core metrics services for Raycynix applications.</Description>
        <PackageTags>raycynix;metrics;prometheus;observability;healthchecks;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Metrics.Abstractions\Raycynix.Extensions.Metrics.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.3" />
        <PackageReference Include="prometheus-net" Version="8.2.1"/>
    </ItemGroup>

</Project>
