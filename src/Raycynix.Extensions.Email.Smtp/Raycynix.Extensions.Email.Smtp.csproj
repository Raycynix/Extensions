<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Added SMTP email provider integration for Raycynix.Extensions.Email.</PackageReleaseNotes>

        <Description>SMTP provider integration for Raycynix email, including SMTP configuration binding, validation, and message delivery.</Description>
        <PackageTags>raycynix;email;smtp;mail;sender;provider;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Configuration.Abstractions\Raycynix.Extensions.Configuration.Abstractions.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Email\Raycynix.Extensions.Email.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Email.Abstractions\Raycynix.Extensions.Email.Abstractions.csproj" />
    </ItemGroup>
</Project>
