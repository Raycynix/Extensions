<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>Moved shared database configuration, provider, builder, model assembly registry, and observability contracts into the abstractions package for lightweight integrations.</PackageReleaseNotes>

        <Description>Lightweight contracts and configuration models for Raycynix database providers, EF Core configurators, initialization, model assembly registration, and observability integration.</Description>
        <PackageTags>raycynix;database;abstractions;contracts;efcore;configurators;providers;configuration;observability;initialization;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    </ItemGroup>

</Project>
