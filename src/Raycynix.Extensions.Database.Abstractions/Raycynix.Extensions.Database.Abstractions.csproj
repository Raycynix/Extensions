<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v2.2.0 starts unified versioning for Raycynix packages.</PackageReleaseNotes>

        <Description>Lightweight contracts and configuration models for Raycynix database providers, provider validation, EF Core configurators, initialization, model assembly registration, and observability integration.</Description>
        <PackageTags>raycynix;database;abstractions;contracts;efcore;configurators;providers;provider-validation;configuration;observability;initialization;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9"/>
    </ItemGroup>

</Project>
