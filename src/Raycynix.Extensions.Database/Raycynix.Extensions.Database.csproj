<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Added custom Raycynix database context registration, default no-op database observability, and lighter core dependencies with observability moved to a dedicated package.</PackageReleaseNotes>

        <Description>Core Raycynix EF Core database infrastructure with shared context registration, custom context support, model assembly discovery, initialization, and provider-agnostic model caching.</Description>
        <PackageTags>raycynix;database;efcore;entityframework;dbcontext;custom-context;configurators;model-cache;assembly-discovery;initialization;provider-agnostic;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Logging\Raycynix.Extensions.Logging.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7"/>
    </ItemGroup>

</Project>
