<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.4.1</Version>

        <IsPackable>true</IsPackable>

        <Description>RabbitMQ-specific messaging configuration and DI integration for Raycynix applications.</Description>
        <PackageTags>raycynix;messaging;rabbitmq;events;integration;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Messaging\Raycynix.Extensions.Messaging.csproj" />
    </ItemGroup>

</Project>
