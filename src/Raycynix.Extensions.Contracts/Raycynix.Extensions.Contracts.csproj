<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.0</Version>

        <IsPackable>true</IsPackable>

        <Description>Shared API contracts, semantic versioning primitives, paging models, and transport-safe error shapes for .NET applications.</Description>
        <PackageTags>raycynix;contracts;dto;versioning;api;errors;paging;validation;serialization;dotnet</PackageTags>
        <PackageReleaseNotes>v2.2.0 starts unified versioning for Raycynix packages.</PackageReleaseNotes>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

</Project>
