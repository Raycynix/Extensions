<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 replaces ElasticConfiguration with ElasticOptions, uses conventional nested section binding, validates HTTP or HTTPS endpoints, and prevents dependency cycles during Serilog startup.</PackageReleaseNotes>

        <Description>Validated Elasticsearch sink options and integration for the Raycynix Serilog logging pipeline.</Description>
        <PackageTags>raycynix;logging;serilog;elasticsearch;elastic;options;structured-logging;sink;integration;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Logging\Raycynix.Extensions.Logging.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Elastic.Channels" Version="0.48.0"/>
        <PackageReference Include="Elastic.Ingest.Elasticsearch" Version="0.48.0"/>
        <PackageReference Include="Elastic.Serilog.Sinks" Version="9.0.0"/>
        <PackageReference Include="Elastic.Transport" Version="1.0.0"/>
    </ItemGroup>

</Project>
