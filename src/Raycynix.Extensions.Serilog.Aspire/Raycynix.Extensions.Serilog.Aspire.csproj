<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>
        <IsPackable>true</IsPackable>

        <Description>Aspire AppHost integration for the Raycynix Serilog logging pipeline.</Description>
        <PackageTags>raycynix;serilog;logging;aspire;apphost;structured-logging;dotnet</PackageTags>
        <PackageReleaseNotes>v3.0.0 adds direct Raycynix Serilog registration for Aspire AppHost applications.</PackageReleaseNotes>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="true" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Serilog\Raycynix.Extensions.Serilog.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="13.4.6"/>
    </ItemGroup>

</Project>
