<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>

        <Description>ASP.NET Core integrations for Raycynix configuration source setup, application environment registration, configurable feature gate middleware, endpoint metadata, and Minimal API feature gates.</Description>
        <PackageTags>raycynix;configuration;aspnetcore;feature-flags;feature-gates;minimal-api;middleware;endpoints;options;dotnet</PackageTags>
        <PackageReleaseNotes>v2.0.0 adds configurable feature gate response status codes, lazy feature flag accessor resolution, and ASP.NET Core registration helpers aligned with Configuration v2.</PackageReleaseNotes>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
