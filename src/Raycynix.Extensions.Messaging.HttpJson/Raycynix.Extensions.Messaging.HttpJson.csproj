<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.2.2</Version>
        
        <IsPackable>true</IsPackable>
        
        <Description>HTTP JSON direct request/response transport for Raycynix messaging.</Description>
        <PackageTags>raycynix;messaging;http;json;newtonsoft;microservices;dotnet</PackageTags>
        
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Messaging\Raycynix.Extensions.Messaging.csproj" />
    </ItemGroup>

</Project>
