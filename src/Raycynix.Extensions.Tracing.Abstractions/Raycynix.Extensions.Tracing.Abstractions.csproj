<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Starts unified versioning for Raycynix packages from this release.</PackageReleaseNotes>

        <Description>Abstractions and contracts for Raycynix tracing services, activity-based tracer APIs, and shared tracing primitives.</Description>
        <PackageTags>raycynix;tracing;abstractions;contracts;activitysource;diagnostics;correlation;primitives;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

</Project>
