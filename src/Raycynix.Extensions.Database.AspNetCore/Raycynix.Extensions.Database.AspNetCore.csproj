<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>Provides ASP.NET Core WebApplication startup helpers for running Raycynix database initialization through the shared hosting integration.</PackageReleaseNotes>

        <Description>ASP.NET Core startup integration for running Raycynix database initialization from WebApplication while reusing the shared database hosting extensions.</Description>
        <PackageTags>raycynix;database;aspnetcore;webapplication;web;startup;initialization;migrations;minimal-api;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Hosting\Raycynix.Extensions.Database.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
