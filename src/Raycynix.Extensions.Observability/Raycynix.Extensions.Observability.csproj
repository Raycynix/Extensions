<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Starts unified versioning for Raycynix packages from this release and removes the mandatory Raycynix logging registration from observability composition.</PackageReleaseNotes>

        <Description>Core observability composition for Raycynix applications, combining metrics, tracing, and ambient operation context registration into a single infrastructure surface.</Description>
        <PackageTags>raycynix;observability;metrics;tracing;correlation;operation-context;composition;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Common\Raycynix.Extensions.Common.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Metrics\Raycynix.Extensions.Metrics.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Tracing\Raycynix.Extensions.Tracing.csproj"/>
    </ItemGroup>
</Project>
