<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.2.0</Version>

        <IsPackable>true</IsPackable>

        <Description>Core observability composition for Raycynix applications.</Description>
        <PackageTags>raycynix;observability;logging;metrics;tracing;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Common\Raycynix.Extensions.Common.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Logging\Raycynix.Extensions.Logging.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Metrics\Raycynix.Extensions.Metrics.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Tracing\Raycynix.Extensions.Tracing.csproj"/>
    </ItemGroup>
</Project>
