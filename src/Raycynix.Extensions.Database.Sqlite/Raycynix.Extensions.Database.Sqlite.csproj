<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>Added SQLite provider registration with provider-specific validation, SQLite connection-string composition, mode and cache options, command timeout, and migrations assembly support.</PackageReleaseNotes>

        <Description>SQLite provider integration for Raycynix.Extensions.Database with AddSqlite registration, provider-specific validation, SQLite connection-string composition, and EF Core UseSqlite configuration.</Description>
        <PackageTags>raycynix;database;sqlite;provider;provider-validation;efcore;entityframework;migrations;connection-string;embedded-database;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
        <PackageReference Include="SQLitePCLRaw.core" Version="3.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj" />
    </ItemGroup>

</Project>
