<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.1.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>Provides generic host and IServiceProvider startup helpers for running Raycynix database initialization through IDatabaseInitializer.</PackageReleaseNotes>

        <Description>Generic host startup integration for running Raycynix database initialization through IDatabaseInitializer in workers, services, and console applications.</Description>
        <PackageTags>raycynix;database;hosting;generic-host;startup;initialization;migrations;workers;services;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8"/>
    </ItemGroup>

</Project>
