<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Starts unified versioning for Raycynix packages from this release and adds optional Microsoft.Extensions.Logging diagnostics for gRPC messaging.</PackageReleaseNotes>

        <Description>gRPC direct request/response transport for Raycynix messaging with logical operation routing, generated client integration, and configuration-based registration.</Description>
        <PackageTags>raycynix;messaging;grpc;direct-requests;request-response;protobuf;client;transport;configuration;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client" Version="2.80.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Messaging\Raycynix.Extensions.Messaging.csproj"/>
    </ItemGroup>

</Project>
