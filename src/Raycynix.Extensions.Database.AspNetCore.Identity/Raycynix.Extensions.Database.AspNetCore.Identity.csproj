<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.1.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Added ASP.NET Core Identity database integration with default and generic Raycynix IdentityDbContext implementations, strict identity-context registration, model configurator discovery, provider validation, initialization, and model-cache integration.</PackageReleaseNotes>

        <Description>ASP.NET Core Identity EF Core integration for Raycynix.Extensions.Database with default and generic IdentityDbContext registration, custom identity context support, model assembly discovery, provider validation, initialization, and model-cache integration.</Description>
        <PackageTags>raycynix;database;aspnetcore;identity;aspnetcore-identity;efcore;entityframework;identitydbcontext;custom-context;generic-identity;configurators;model-cache;migrations;assembly-discovery;initialization;provider-validation;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Database\Raycynix.Extensions.Database.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    </ItemGroup>

</Project>
