{
  "LoggingConfiguration": {
    "ServiceName": "raycynix-email-example",
    "Environment": "Development",
    "MinimumLevel": "Information",
    "UseElastic": false,
    "OutputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] [{ServiceName}] [{ServiceVersion}] [Env:{Environment}] {Message:lj} {NewLine}{Exception}"
  },
  "EmailExample": {
    "Send": true,
    "ToAddress": "reciepient@example.com",
    "ToDisplayName": "Example Name"
  },
  "EmailConfiguration": {
    "DefaultFromAddress": "support@raycynix.com",
    "DefaultFromDisplayName": "Raycynix Support",
    "DefaultReplyToAddress": "support@raycynix.com",
    "DefaultReplyToDisplayName": "Raycynix Support",
    "SmtpConfiguration": {
      "Host": "smtp.example.com",
      "Port": 587,
      "EnableSsl": true,
      "SecureSocketOptions": "StartTls",
      "TimeoutMilliseconds": 100000
    }
  }
}
