{
  "AllowedHosts": "*",
  "LoggingConfiguration": {
    "ServiceName": "raycynix-database-aspnetcore-example",
    "MinimumLevel": "Information",
    "UseElastic": false
  },
  "DatabaseConfiguration": {
    "ConnectionConfiguration": {
      "Name": "raycynix-database-aspnetcore-example.db"
    },
    "EnsureCreated": true,
    "UseMigrations": false,
    "EnableSeed": true,
    "EnableLazyLoading": false,
    "EnableAutoDetectChanges": true,
    "UseQueryTrackingByDefault": true,
    "RetryCount": 3,
    "RetryDelaySeconds": 2,
    "SqliteConfiguration": {
      "Mode": "ReadWriteCreate",
      "Cache": "Shared",
      "CommandTimeoutSeconds": 30
    }
  }
}
